node_modules/

# Game data — large, recoverable from the original ISO
web/assets/

# Lifter output — regenerable from /lifter via `node lifter/lift.js`
generated/

# Run-time snapshots / debug artifacts
frames/
sprites/

# Diff-test reports — regenerable via tools/bulk-diff-test.js
tools/bulk-diff-report.json
tools/c-to-js/translation-report.json
tools/missing-indirect-calls.json

# Ghidra project state (binary, regenerable from binary/rct.exe)
decompiled/ghidra-project/

# OS / editor noise
.DS_Store
*.log

# Generated analysis artifacts (regenerable from tools/; large)
#   call graph: node tools/build-callgraph.js
#   dynamic graph: node tools/trace-callgraph.js
#   subsystem map: node tools/cluster-subsystems.js
#   atlas: node tools/atlas-build.js --structs && --assemble && --match
tools/callgraph.json
tools/dynamic-callgraph.json
tools/subsystems.json
tools/struct-offsets.json
tools/atlas.json
